{
  "expo": {
    "name": "Wayraa",
    "slug": "Wayraa-Mobile",
    "version": "1.0.0",
    "scheme": "wayraa",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wayraa.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFBF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.wayraa.mobile",
      "versionCode": 3,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-status-bar",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wayraa uses your location to show destinations and places near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wayraa uses your photos so you can add them to the trip stories you share.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBF8"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager's Room database: R8 stripped the generated class and the app crashed at launch\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n-keep class androidx.room.** { *; }\n-dontwarn androidx.room.paging.**"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "48e9336f-9b5b-4349-8f21-9f9522aa7a93"
      }
    }
  }
}
